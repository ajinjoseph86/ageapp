# Copy this file to .env and fill in your real key.
# Get a key from https://kie.ai
KIE_API_KEY=your_kie_ai_api_key_here

# Port the local server runs on (optional)
PORT=3000

# Hard daily spend cap in USD. The server refuses to make further
# kie.ai calls once this is reached for the current day (Asia/Singapore time).
DAILY_BUDGET_USD=10.00
